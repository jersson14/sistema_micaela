# ========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ========================================
DB_HOST=db
DB_PORT=3306
DB_NAME=micaela
DB_USER=micaela_user
DB_PASSWORD=micaela_pass_2024

# ========================================
# CONFIGURACIÓN DE GREENTER/SUNAT
# ========================================
# Modo: beta o produccion
SUNAT_MODE=beta
RUC_EMPRESA=20XXXXXXXXX
RAZON_SOCIAL_EMPRESA=EMPRESA DE TRANSPORTES TOURS MICAELA

# Rutas de certificados
CERT_PATH=/var/www/html/greenter/certificados/certificado.pem

# ========================================
# CONFIGURACIÓN DE APLICACIÓN
# ========================================
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Lima

# ========================================
# CONFIGURACIÓN DE SESIÓN
# ========================================
SESSION_LIFETIME=7200
SESSION_SECURE=false
