# =====================================================================
# Configuración de Nubefact (OSE) — PLANTILLA
#
# 1. Copia este archivo como:  .env.nubefact   (en la misma carpeta)
# 2. Completa la RUTA y el TOKEN de tu cuenta Nubefact
#    (panel de Nubefact → API (Integración)).
# 3. Listo: desde ese momento el sistema factura por Nubefact.
#
# Para volver a enviar directo a SUNAT: pon NUBEFACT_ACTIVO=0
# o elimina el archivo .env.nubefact.
#
# IMPORTANTE: .env.nubefact NO se sube a git (contiene el token).
# =====================================================================

NUBEFACT_RUTA=https://api.nubefact.com/api/v1/PEGA-AQUI-TU-RUTA
NUBEFACT_TOKEN=PEGA-AQUI-TU-TOKEN

# 1 = facturar por Nubefact | 0 = enviar directo a SUNAT (como antes)
NUBEFACT_ACTIVO=1

# Solo informativo, se muestra en los logs: DEMO o PRODUCCION
NUBEFACT_MODO=DEMO

# Opcional: si la cuenta DEMO exige otras series, mapéalas (serie del sistema:serie en Nubefact).
# Ejemplo: NUBEFACT_SERIES=FPP1:FFF1,BPP1:BBB1,FC01:FFF1,BC01:BBB1
# En PRODUCCIÓN déjalo vacío: se usan las mismas series del sistema.
NUBEFACT_SERIES=
