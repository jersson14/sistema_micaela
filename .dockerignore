# Ignorar archivos innecesarios en la imagen Docker
.git
.gitignore
.env
.vscode
.idea
*.md
README.md
LICENSE

# Logs y temporales
*.log
*.tmp
*.cache
debug_*.log
error_*.log

# Archivos de backup
*.sql
*.zip
*.tar.gz
backup/

# Dependencias (se instalarán con composer)
vendor/

# Archivos de sistema
.DS_Store
Thumbs.db
desktop.ini

# Archivos de configuración local
config_local.php
.htaccess.local

# Certificados sensibles (copiar manualmente después)
greenter/certificados/*.pem
greenter/certificados/*.pfx
